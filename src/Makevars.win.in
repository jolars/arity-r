TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu

TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libarity.a
PKG_LIBS = -L$(LIBDIR) -larity -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/vendor

$(STATLIB):
	mkdir -p "$(CARGOTMP)/libgcc_mock"
	touch "$(CARGOTMP)/libgcc_mock/libgcc_eh.a"

	if [ -d ./vendor ]; then \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	elif [ -f ./rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz && \
		mkdir -p "$(CARGOTMP)" && \
		cp rust/vendor-config.toml "$(CARGOTMP)/config.toml"; \
	fi

	export CARGO_HOME="$(CARGOTMP)" && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CARGOTMP)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo build -j 2 @CRAN_FLAGS@ --lib @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir="$(TARGET_DIR)" --target=$(TARGET)

	export CARGO_HOME="$(CARGOTMP)" && \
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CARGOTMP)/libgcc_mock" && \
	RUSTFLAGS="$(RUSTFLAGS) --print=native-static-libs" cargo run -j 2 @CRAN_FLAGS@ --bin document @PROFILE@ --manifest-path=./rust/Cargo.toml --target-dir="$(TARGET_DIR)" --target=$(TARGET)

	rm -Rf "$(CARGOTMP)"

rust_clean: $(SHLIB)
	rm -Rf "$(CARGOTMP)" "$(VENDOR_DIR)" @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) "$(TARGET_DIR)" "$(VENDOR_DIR)"
